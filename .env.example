# Server model for generation and edit planning (judges need no key of their own)
GROQ_API_KEY=
# Optional: any chat model your Groq plan offers (default openai/gpt-oss-120b; see console Settings → Limits)
# GROQ_MODEL=

# Operational switches for model-funded routes
# AI_DISABLED=1               # kill switch: AI routes return 503; manual editing/export keep working
# AI_RATE_LIMIT_PER_MINUTE=10 # per client per minute

# Shared rate limit across serverless instances (recommended for a public deploy).
# Without these, a per-process limiter is used (local/protected preview only).
# If either is configured but shared limiting fails, AI returns 503 instead of falling back.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Live mic (Deepgram streaming): complete thoughts submit after a pause; unfinished clauses wait.
# The mic button appears automatically once all three are set. Put the site behind access
# protection or a shared rate limit before enabling it publicly; it mints short-lived Deepgram keys.
# DEEPGRAM_ENABLED=1
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

NEXT_PUBLIC_BASE_URL=
